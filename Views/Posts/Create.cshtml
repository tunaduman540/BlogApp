@model BlogApp.ViewModels.CreatePostViewModel

@{
    ViewData["Title"] = "Yeni Yazı";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-7">

        <div class="mb-4">
            <a asp-action="Index" class="text-decoration-none text-secondary">
                ← Blog yazılarına dön
            </a>

            <h1 class="fw-bold mt-3 mb-2">Yeni Blog Yazısı</h1>
            <p class="text-secondary">
                Düşüncelerini yazıya dök ve paylaş.
            </p>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">

                <form asp-controller="Posts" asp-action="Create" method="post">

                    <div class="mb-4">
                        <label asp-for="Title" class="form-label fw-semibold">
                            Yazı başlığı
                        </label>

                        <input asp-for="Title" class="form-control" placeholder="Örn. ASP.NET Core öğreniyorum" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Content" class="form-label fw-semibold">
                            Yazı içeriği
                        </label>

                        <textarea asp-for="Content" class="form-control" rows="8"
                                  placeholder="Yazını buraya yaz..."></textarea>
                    </div>

                    
                    <div class="mb-3">
                        <label class="form-label">Etiketler</label>

                        @foreach (var tag in ViewBag.Tags)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="SelectedTagIds" value="@tag.Id"
                                       id="tag_@tag.Id" />

                                <label class="form-check-label" for="tag_@tag.Id">
                                    @tag.Name
                                </label>
                            </div>
                        }
                    </div>


                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary">
                            Yazıyı Kaydet
                        </button>

                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Vazgeç
                        </a>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>
