
@model BlogApp.Entities.Post

@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-5">

    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-4 p-md-5">

            <div class="d-flex flex-wrap justify-content-between
                        align-items-center gap-2 mb-3">

                <span class="badge rounded-pill text-bg-primary px-3 py-2">
                    <i class="bi bi-journal-text me-1"></i>
                    Blog Yazısı
                </span>

                <small class="text-secondary">
                    <i class="bi bi-calendar3 me-1"></i>
                    @Model.PublishedOn.ToString("dd.MM.yyyy")
                </small>

            </div>

            <h1 class="fw-bold mb-4">@Model.Title</h1>

            <div class="d-flex align-items-center gap-2 mb-4">

                @if (Model.User?.ProfileImage != null)
                {
                    <img src="@Url.Action("ProfileImage", "Account",
                                 new { id = Model.UserId })"
                         alt="Profil fotoğrafı"
                         class="rounded-circle"
                         width="48"
                         height="48"
                         style="object-fit: cover;" />
                }
                else
                {
                    <div class="rounded-circle bg-primary text-white fw-bold
                                d-flex align-items-center justify-content-center"
                         style="width: 48px; height: 48px; flex-shrink: 0;">
                        @(string.IsNullOrEmpty(Model.User?.Username)
                            ? "?"
                            : Model.User.Username.Substring(0, 1).ToUpper())
                    </div>
                }

                <div>
                    <small class="text-secondary d-block">Yazar</small>

                    <a asp-controller="Account"
                       asp-action="UserProfile"
                       asp-route-id="@Model.UserId"
                       class="fw-semibold text-decoration-none text-dark">
                        @Model.User?.Username
                    </a>
                </div>

            </div>

            <hr class="my-4" />

            <div class="fs-5 lh-lg" style="white-space: pre-wrap;">@Model.Content</div>

            @if (Model.PostTags.Any())
            {
                <div class="mt-4 pt-3 border-top">

                    <span class="fw-semibold me-2">
                        <i class="bi bi-tags me-1"></i>
                        Etiketler:
                    </span>

                    @foreach (var postTag in Model.PostTags)
                    {
                        <span class="badge rounded-pill text-bg-light
                                     border text-dark me-1 mb-1 px-3 py-2">
                            @postTag.Tag.Name
                        </span>
                    }

                </div>
            }

        </div>
    </div>

    <div class="d-flex align-items-center gap-2 mb-4">
        <i class="bi bi-chat-dots text-primary fs-3"></i>
        <h3 class="fw-bold mb-0">Yorumlar</h3>
        <span class="badge rounded-pill text-bg-primary">
            @Model.Comments.Count
        </span>
    </div>

    @if (Model.Comments.Any())
    {
        @foreach (var comment in Model.Comments)
        {
            <div class="card border-0 shadow-sm rounded-4 mb-3">
                <div class="card-body p-4">

                    <div class="d-flex align-items-start gap-3">

                        @if (comment.User?.ProfileImage != null)
                        {
                            <img src="@Url.Action("ProfileImage", "Account",
                                         new { id = comment.UserId })"
                                 alt="Profil fotoğrafı"
                                 class="rounded-circle"
                                 width="44"
                                 height="44"
                                 style="object-fit: cover; flex-shrink: 0;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-primary text-white fw-bold
                                        d-flex align-items-center justify-content-center"
                                 style="width: 44px; height: 44px; flex-shrink: 0;">
                                @(string.IsNullOrEmpty(comment.User?.Username)
                                    ? "?"
                                    : comment.User.Username.Substring(0, 1).ToUpper())
                            </div>
                        }

                        <div class="flex-grow-1">

                            <div class="d-flex flex-wrap justify-content-between
                                        align-items-center gap-2 mb-2">

                                <a asp-controller="Account"
                                   asp-action="UserProfile"
                                   asp-route-id="@comment.UserId"
                                   class="fw-bold text-decoration-none text-dark">
                                    @comment.User?.Username
                                </a>

                                <small class="text-secondary">
                                    <i class="bi bi-clock me-1"></i>
                                    @comment.PublishedOn.ToString("dd.MM.yyyy HH:mm")
                                </small>

                            </div>

                            <p class="mb-0" style="white-space: pre-wrap;">@comment.Text</p>

                            @if (User.Identity != null
                                && User.Identity.IsAuthenticated
                                && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                                    == comment.UserId.ToString())
                            {
                                <div class="d-flex flex-wrap gap-2 mt-3">

                                    <a asp-controller="Posts"
                                       asp-action="EditComment"
                                       asp-route-id="@comment.Id"
                                       class="btn btn-outline-warning btn-sm rounded-pill px-3">
                                        <i class="bi bi-pencil me-1"></i>
                                        Yorumu Düzenle
                                    </a>

                                    <form asp-controller="Posts"
                                          asp-action="DeleteComment"
                                          asp-route-id="@comment.Id"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                                onclick="return confirm('Bu yorumu silmek istediğine emin misin?');">
                                            <i class="bi bi-trash me-1"></i>
                                            Yorumu Sil
                                        </button>

                                    </form>

                                </div>
                            }

                        </div>
                    </div>

                </div>
            </div>
        }
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body text-center py-5">

                <i class="bi bi-chat-square-text text-secondary"
                   style="font-size: 3rem;"></i>

                <h5 class="fw-bold mt-3">Henüz yorum yapılmamış</h5>

                <p class="text-secondary mb-0">
                    Bu yazı hakkındaki düşüncelerini ilk paylaşan sen olabilirsin.
                </p>

            </div>
        </div>
    }

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div class="card border-0 shadow-sm rounded-4 mt-4 mb-4">
            <div class="card-body p-4">

                <h4 class="fw-bold mb-3">
                    <i class="bi bi-chat-left-text text-primary me-2"></i>
                    Yorum Yap
                </h4>

                @if (TempData["CommentError"] != null)
                {
                    <div class="alert alert-danger rounded-3">
                        @TempData["CommentError"]
                    </div>
                }

                <form asp-controller="Posts"
                      asp-action="AddComment"
                      asp-route-postId="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="Text" class="form-label fw-semibold">
                            Yorumun
                        </label>

                        <textarea id="Text"
                                  name="Text"
                                  class="form-control rounded-3"
                                  rows="4"
                                  placeholder="Düşüncelerini paylaş..."
                                  required></textarea>
                    </div>

                    <button type="submit"
                            class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-send me-1"></i>
                        Yorumu Gönder
                    </button>

                </form>

            </div>
        </div>
    }
    else
    {
        <div class="alert alert-light border rounded-4 mt-4 p-4">
            <i class="bi bi-info-circle text-primary me-2"></i>

            Yorum yapmak için
            <a asp-controller="Account"
               asp-action="Login"
               class="fw-semibold text-decoration-none">
                giriş yapmalısın.
            </a>
        </div>
    }

    <a asp-controller="Posts"
       asp-action="Index"
       class="btn btn-outline-secondary rounded-pill px-4 mt-3">
        <i class="bi bi-arrow-left me-1"></i>
        Yazılara Dön
    </a>

</div>