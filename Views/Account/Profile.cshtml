
@model BlogApp.ViewModels.UserProfileViewModel

@{
    ViewData["Title"] = Model.Username + " - Profil";
}

<div class="container py-5">

    <!-- Profil üst alanı -->
    <div class="card border-0 shadow-sm rounded-4 mb-5 overflow-hidden">

        <div style="height: 150px; background: linear-gradient(135deg, #0d6efd, #6f42c1);">
        </div>

        <div class="card-body px-4 px-md-5 pb-4">

            <div class="d-flex flex-column flex-md-row align-items-center align-items-md-end gap-3"
                 style="margin-top: -75px;">

                <!-- Profil fotoğrafı veya baş harf -->
                @if (Model.UserId > 0)
                {
                    <img src="@Url.Action("ProfileImage", "Account", new { id = Model.UserId })"
                         alt="Profil fotoğrafı"
                         class="rounded-circle border border-4 border-white shadow"
                         width="130"
                         height="130"
                         style="object-fit: cover; background-color: #0d6efd;"
                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                    <div class="rounded-circle border border-4 border-white shadow
                                align-items-center justify-content-center
                                text-white fw-bold"
                         style="display: none; width: 130px; height: 130px;
                                background-color: #0d6efd; font-size: 48px; flex-shrink: 0;">
                        @(string.IsNullOrEmpty(Model.Username)
                            ? "?"
                            : Model.Username.Substring(0, 1).ToUpper())
                    </div>
                }

                <div class="flex-grow-1 text-center text-md-start">
                    <h2 class="fw-bold mb-1">@Model.Username</h2>

                    <p class="text-secondary mb-0">
                        <i class="bi bi-envelope me-1"></i>
                        @Model.Email
                    </p>
                </div>

                @if (User.Identity != null && User.Identity.IsAuthenticated
                    && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                        == Model.UserId.ToString())
                {
                    <a asp-controller="Account"
                       asp-action="EditProfileImage"
                       class="btn btn-outline-primary rounded-pill px-4">
                        <i class="bi bi-camera me-1"></i>
                        Fotoğrafı Değiştir
                    </a>
                }

            </div>

            <hr class="my-4" />

            <!-- Profil istatistikleri -->
            <div class="row text-center g-3">

                <div class="col-6">
                    <div class="bg-light rounded-3 p-3 h-100">
                        <h3 class="fw-bold text-primary mb-1">
                            @Model.Posts.Count
                        </h3>
                        <span class="text-secondary small">Blog Yazısı</span>
                    </div>
                </div>

                <div class="col-6">
                    <div class="bg-light rounded-3 p-3 h-100">
                        <h3 class="fw-bold text-primary mb-1">
                            @(Model.Posts.Sum(p => p.Comments?.Count ?? 0))
                        </h3>
                        <span class="text-secondary small">Yazılara Yapılan Yorum</span>
                    </div>
                </div>

            </div>

        </div>
    </div>

    <!-- Kullanıcının yazıları -->
    <div class="d-flex flex-wrap justify-content-between
                align-items-center gap-3 mb-4">

        <div>
            <h3 class="fw-bold mb-1">Blog Yazıları</h3>
            <p class="text-secondary mb-0">
                @Model.Username tarafından paylaşılan yazılar
            </p>
        </div>

        @if (User.Identity != null && User.Identity.IsAuthenticated
            && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                == Model.UserId.ToString())
        {
            <a asp-controller="Posts"
               asp-action="Create"
               class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-plus-lg me-1"></i>
                Yeni Yazı
            </a>
        }

    </div>

    @if (Model.Posts.Any())
    {
        <div class="row g-4">

            @foreach (var post in Model.Posts)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 border-0 shadow-sm rounded-4">

                        <div class="card-body p-4 d-flex flex-column">

                            <div class="d-flex justify-content-between
                                        align-items-center mb-3">

                                <span class="badge rounded-pill text-bg-primary">
                                    Blog Yazısı
                                </span>

                                <small class="text-secondary">
                                    @post.PublishedOn.ToString("dd.MM.yyyy")
                                </small>

                            </div>

                            <h5 class="fw-bold mb-3">
                                @post.Title
                            </h5>

                            <p class="text-secondary">
                                @(post.Content.Length > 150
                                    ? post.Content.Substring(0, 150) + "..."
                                    : post.Content)
                            </p>

                            <div class="mt-auto pt-3">

                                <a asp-controller="Posts"
                                   asp-action="Details"
                                   asp-route-id="@post.Id"
                                   class="btn btn-outline-primary rounded-pill w-100">
                                    Yazıyı Görüntüle
                                    <i class="bi bi-arrow-right ms-1"></i>
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center py-5">

                <div class="mb-3">
                    <i class="bi bi-journal-text text-primary"
                       style="font-size: 3rem;"></i>
                </div>

                <h5 class="fw-bold">Henüz yazı paylaşılmamış</h5>

                <p class="text-secondary mb-4">
                    Bu kullanıcı henüz bir blog yazısı paylaşmadı.
                </p>

                @if (User.Identity != null && User.Identity.IsAuthenticated
                    && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                        == Model.UserId.ToString())
                {
                    <a asp-controller="Posts"
                       asp-action="Create"
                       class="btn btn-primary rounded-pill px-4">
                        İlk Yazını Oluştur
                    </a>
                }

            </div>
        </div>
    }

</div>