<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - BlogApp</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
            body {
                background-color: #f5f7fb;
                color: #212529;
            }

            .navbar-brand {
                font-weight: 800;
                letter-spacing: -0.5px;
            }

            .navbar {
                box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
            }

            .main-content {
                min-height: 75vh;
            }

            .blog-card {
                border: none;
                border-radius: 16px;
                transition: transform 0.2s, box-shadow 0.2s;
            }

            .blog-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
            }

            .form-control {
                padding: 12px;
                border-radius: 10px;
            }

            .btn {
                border-radius: 10px;
                padding: 10px 18px;
            }

            footer {
                color: #6c757d;
            }
    </style>
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <span class="text-info">Blog</span>App
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false" aria-label="Menüyü aç">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Profile">
                                Profilim
                            </a>
                        </li>
                    }
                    
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            Ana Sayfa
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Posts" asp-action="Index">
                            Blog Yazıları
                        </a>
                    </li>

                    @if (User.Identity != null
                    && User.Identity.IsAuthenticated
                    && User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link fw-bold text-primary" asp-controller="Admin" asp-action="Index">
                                <i class="bi bi-shield-check me-1"></i>
                                Admin Paneli
                            </a>
                        </li>
                    }

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Profile">
                                Profilim
                            </a>
                        </li>

                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm ms-2">
                                    Çıkış Yap
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-outline-primary btn-sm me-2" asp-controller="Account" asp-action="Login">
                                Giriş Yap
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">
                                Kayıt Ol
                            </a>
                        </li>
                    }


                </ul>
            </div>
        </div>
    </nav>

    <main class="container main-content py-5">
        @RenderBody()
    </main>

    <footer class="container text-center py-4 border-top">
        <small>© @DateTime.Now.Year BlogApp · Fikirlerini paylaş.</small>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
